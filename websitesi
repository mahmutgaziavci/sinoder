<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SİNODER - Bursa Sinema Dizi Oyuncuları Derneği</title>
    <!-- Google Fonts & FontAwesome İkonları -->
    <link href="https://googleapis.com" rel="stylesheet">
    <link rel="stylesheet" href="https://cloudflare.com">
    
    <style>
        /* EXCLUSIVE DARK MODERNE TEMA AYARLARI */
        :root {
            --bg-dark: #0a0a0c;
            --bg-card: #121216;
            --gold-primary: #d4af37;
            --gold-secondary: #aa8416;
            --text-main: #ffffff;
            --text-muted: #a0a0a5;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Montserrat', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* HEADER & LOGO */
        header {
            padding: 30px 20px;
            background: linear-gradient(to bottom, rgba(0,0,0,0.8), transparent);
            max-width: 1200px;
            margin: 0 auto;
        }

        .brand-container {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .logo-placeholder {
            width: 75px;
            height: 75px;
            background: radial-gradient(circle, var(--gold-primary) 0%, var(--gold-secondary) 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 20px rgba(212, 175, 55, 0.4);
            margin-bottom: 12px;
        }

        .logo-placeholder i {
            color: #000;
            font-size: 34px;
        }

        .brand-subtitle {
            font-size: 16px;
            font-weight: 800;
            color: var(--gold-primary);
            letter-spacing: 3px;
            margin-bottom: 2px;
            text-transform: uppercase;
        }

        .brand-title {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1px;
            color: var(--text-muted);
            text-transform: uppercase;
            line-height: 1.4;
        }

        /* UYGULAMA İÇERİK YAPISI (GRID) */
        .app-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 30px;
            justify-content: center;
        }

        /* MOBİL UYUMLU ÖZEL KARTLAR */
        .feature-card {
            background: linear-gradient(145deg, #15151a, #0b0b0d);
            border: 1px solid rgba(212, 175, 55, 0.15);
            border-radius: 24px;
            padding: 40px 30px;
            text-align: center;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            min-height: 540px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.6);
            position: relative;
            overflow: hidden;
            transition: transform 0.3s ease, border-color 0.3s ease;
        }

        .feature-card:hover {
            transform: translateY(-5px);
            border-color: var(--gold-primary);
        }

        .card-top {
            width: 100%;
        }

        .card-icon {
            font-size: 45px;
            color: var(--gold-primary);
            margin-bottom: 20px;
            text-shadow: 0 0 15px rgba(212, 175, 55, 0.3);
        }

        .card-title {
            font-size: 26px;
            font-weight: 800;
            color: var(--gold-primary);
            margin-bottom: 8px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .card-subtitle {
            font-size: 18px;
            font-weight: 600;
            color: var(--text-main);
            margin-bottom: 20px;
        }

        .card-description {
            font-size: 14px;
            color: var(--text-muted);
            margin-bottom: 30px;
            padding: 0 10px;
        }

        /* BUTONLAR */
        .button-group {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .btn {
            width: 100%;
            padding: 16px 25px;
            border-radius: 30px;
            border: none;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }

        .btn-gold {
            background: linear-gradient(135deg, var(--gold-primary) 0%, var(--gold-secondary) 100%);
            color: #000000;
            box-shadow: 0 6px 20px rgba(212, 175, 55, 0.25);
        }

        .btn-gold:hover {
            background: linear-gradient(135deg, #ffffff 0%, var(--gold-primary) 100%);
            box-shadow: 0 8px 25px rgba(212, 175, 55, 0.45);
        }

        .btn-outline {
            background: transparent;
            border: 2px solid var(--gold-primary);
            color: var(--gold-primary);
        }

        .btn-outline:hover {
            background: rgba(212, 175, 55, 0.1);
            color: #ffffff;
        }

        /* MODAL (WHATSAPP SEÇİM ALANI) */
        .modal {
            display: none;
            position: fixed;
            z-index: 100;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.85);
            backdrop-filter: blur(8px);
            align-items: center;
            justify-content: center;
        }

        .modal-content {
            background-color: var(--bg-card);
            border: 1px solid var(--gold-primary);
            padding: 35px 25px;
            border-radius: 24px;
            text-align: center;
            max-width: 420px;
            width: 90%;
            box-shadow: 0 15px 40px rgba(0,0,0,0.7);
        }

        .modal-content h3 {
            color: var(--gold-primary);
            margin-bottom: 10px;
            font-size: 22px;
        }

        .modal-content p {
            color: var(--text-muted);
            font-size: 14px;
            margin-bottom: 25px;
        }

        .close-modal {
            margin-top: 20px;
            display: inline-block;
            color: var(--text-muted);
            cursor: pointer;
            font-size: 13px;
            text-decoration: underline;
        }

        /* BİLDİRİM TOAST */
        .toast {
            visibility: hidden;
            min-width: 280px;
            background-color: var(--gold-primary);
            color: #000;
            text-align: center;
            border-radius: 50px;
            padding: 16px;
            position: fixed;
            z-index: 105;
            left: 50%;
            bottom: 40px;
            transform: translateX(-50%);
            font-weight: 700;
            font-size: 14px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.4);
        }

        .toast.show {
            visibility: visible;
            animation: fadein 0.5s, fadeout 0.5s 2.5s;
        }

        @keyframes fadein {
            from {bottom: 0; opacity: 0;}
            to {bottom: 40px; opacity: 1;}
        }

        @keyframes fadeout {
            from {bottom: 40px; opacity: 1;}
            to {bottom: 0; opacity: 0;}
        }

        /* MAĞAZA UYUMLULUK BİLGİSİ */
        .app-footer {
            text-align: center;
            padding: 50px 20px;
            color: var(--text-muted);
            font-size: 12px;
            letter-spacing: 1px;
            border-top: 1px solid rgba(255,255,255,0.05);
            margin-top: 60px;
        }

        .app-badges {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-bottom: 15px;
            font-size: 20px;
            color: var(--gold-primary);
        }

        /* RESPONSIVE DÜZEN */
        @media (max-width: 768px) {
            .app-container {
                grid-template-columns: 1fr;
                padding: 15px;
            }
            .feature-card {
                min-height: 500px;
                padding: 30px 20px;
            }
        }
    </style>
</head>
<body>

    <!-- SİTE ÜST ALANI VE LOGO -->
    <header>
        <div class="brand-container">
            <div class="logo-placeholder">
                <i class="fa-solid fa-feather-pointed"></i>
            </div>
            <div class="brand-subtitle">SİNODER</div>
            <div class="brand-title">BURSA SİNEMA DİZİ OYUNCULARI DERNEĞİ</div>
        </div>
    </header>

    <!-- ANA KARTLAR PANELİ -->
    <main class="app-container">

        <!-- KART 1: EĞİTİM PROGRAMLARI -->
        <div class="feature-card">
